---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import VisitBlock from '../components/VisitBlock.astro';
import TwoRays from '../components/TwoRays.astro';
import Grounds from '../components/Grounds.astro';
import HourBand from '../components/HourBand.astro';
import Feasts from '../components/Feasts.astro';
import PhotoChapters from '../components/PhotoChapters.astro';
---
<Base
  description="The Diocesan Shrine of the Divine Mercy on Siari Hills, Sindangan, Zamboanga del Norte: a whitewashed hilltop chapel and a great statue of the Divine Mercy above the Sulu Sea. Admission is free."
  current="/"
  navTone="dark"
  page="home"
>
  <Hero />
  <VisitBlock />
  <TwoRays />
  <Grounds />
  <PhotoChapters />
  <HourBand />
  <Feasts />
</Base>
