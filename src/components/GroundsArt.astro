    <path transform="translate(5 5)" d="M366 760 L 420 724 L 484 702 L 540 646 L 600 604 L 648 544 L 686 486 M 712 474 L 776 444 L 820 404 L 868 364 L 918 332 L 950 318" stroke="#86bfe4" stroke-width="2" />
