---
/**
 * Siari Hills in cross-section, by day: an original drawing made for this site from visitor
 * descriptions and photographs (2016, 2019). Not to scale.
 */
---
<svg class="grounds-art" viewBox="0 0 1600 900" role="img" aria-labelledby="ga-title ga-desc" preserveAspectRatio="xMidYMid slice">
  <title id="ga-title">Drawing of the shrine grounds on Siari Hills</title>
  <desc id="ga-desc">From the highway arch, stairs climb past a white statue of Our Lady on a lower hill to the whitewashed chapel and its tower on the summit, where the statue of the Divine Mercy stands on the roof deck. A path leads down the far side past alcoves of saints to a garden with a kneeling Christ. The sea lies to the left.</desc>
  <defs>
    <linearGradient id="ga-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#c9dfee" />
      <stop offset="0.55" stop-color="#e6eef1" />
      <stop offset="1" stop-color="#f4f1ea" />
    </linearGradient>
    <linearGradient id="ga-sea" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#5a8fb3" />
      <stop offset="1" stop-color="#1d4a6e" />
    </linearGradient>
    <linearGradient id="ga-hill" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#55765f" />
      <stop offset="1" stop-color="#2f4b3c" />
    </linearGradient>
    <linearGradient id="ga-mary" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#6a8b72" />
      <stop offset="1" stop-color="#3c5a47" />
    </linearGradient>
    <linearGradient id="ga-glass" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#b9d8ea" />
      <stop offset="1" stop-color="#ffe2b6" />
    </linearGradient>
    <radialGradient id="ga-halo" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.95" />
      <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="ga-candle" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#ffcf7a" stop-opacity="0.9" />
      <stop offset="1" stop-color="#ffcf7a" stop-opacity="0" />
    </radialGradient>
    <symbol id="ga-palm" viewBox="-30 -64 60 66">
      <path d="M-1 0 C 0 -20 3 -40 6 -58 L 9 -58 C 6 -40 4 -20 3 0 Z" fill="#3b2f25" />
      <g fill="#2e5a3f">
        <path d="M7 -58 C -6 -66 -20 -60 -28 -48 C -16 -56 -6 -57 7 -56 Z" />
        <path d="M7 -58 C 20 -68 32 -60 30 -46 C 24 -55 16 -58 7 -56 Z" />
        <path d="M7 -58 C 0 -50 -6 -40 -9 -30 C -2 -40 3 -48 8 -55 Z" />
        <path d="M7 -58 C 14 -50 19 -42 21 -32 C 15 -42 11 -49 6 -55 Z" />
        <path d="M7 -58 C 2 -68 -8 -72 -16 -70 C -6 -66 0 -62 7 -57 Z" />
      </g>
    </symbol>
    <symbol id="ga-bush" viewBox="-20 -16 40 18">
      <path d="M-18 2 C -18 -8 -10 -14 -2 -12 C 2 -18 14 -16 16 -8 C 22 -6 20 2 14 2 Z" fill="#41684f" />
    </symbol>
  </defs>

  <!-- sky, sea, far mountains -->
  <rect width="1600" height="900" fill="url(#ga-sky)" />
  <g fill="#ffffff" opacity="0.7">
    <path d="M140 150 c 20 -22 66 -24 84 -4 c 22 -10 52 2 54 22 l -150 0 c -8 -6 -4 -16 12 -18 z" />
