    </g>
  </g>

  <g data-st="roof-deck">
    <path d="M962 226 H1186" stroke="#f7f5ef" stroke-width="3" />
    <path d="M972 226 V246 M1000 226 V246 M1028 226 V246 M1120 226 V246 M1148 226 V246 M1176 226 V246" stroke="#f7f5ef" stroke-width="2" />
    <circle cx="1078" cy="176" r="58" fill="url(#ga-halo)" opacity="0.8" />
    <rect x="1064" y="212" width="28" height="16" fill="#efeae0" />
    <path d="M1064 212 L 1070 158 Q 1078 146 1086 158 L 1092 212 Z" fill="#ffffff" />
    <path d="M1078 176 L 1056 212 L 1070 212 Z" fill="#d8435b" />
    <path d="M1078 176 L 1088 212 L 1103 212 Z" fill="#a9d4ee" />
    <path d="M1070 166 L 1056 138" stroke="#ffffff" stroke-width="6" stroke-linecap="round" />
    <path d="M1083 168 Q 1086 174 1081 177" stroke="#e7e2d8" stroke-width="3" fill="none" stroke-linecap="round" />
    <circle cx="1078" cy="146" r="7.5" fill="#ffffff" />
    <path d="M1072 142 Q 1078 134 1084 142" stroke="#8b6b4f" stroke-width="3" fill="none" />
  </g>

  <!-- candle gallery: warm light on the slope -->
  <g>
    <circle cx="1256" cy="334" r="26" fill="url(#ga-candle)" />
    <rect x="1232" y="322" width="48" height="22" fill="#f2efe8" />
    <path d="M1228 323 L 1256 310 L 1284 323 Z" fill="#8d7a66" />
    <rect x="1240" y="328" width="32" height="12" fill="#ffd27f" />
