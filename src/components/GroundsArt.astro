  </g>
  <rect y="420" width="1600" height="480" fill="url(#ga-sea)" />
  <path d="M0 420 H1600" stroke="#ffffff" stroke-opacity="0.5" stroke-width="1.5" />
  <g fill="#ffffff" opacity="0.35">
    <rect x="70" y="470" width="90" height="2" rx="1" />
    <rect x="210" y="520" width="140" height="2" rx="1" />
    <rect x="40" y="600" width="120" height="2" rx="1" />
    <rect x="260" y="650" width="70" height="2" rx="1" />
  </g>
  <path fill="#aebfcf" d="M700 420 C 800 352 880 316 980 330 C 1080 286 1190 236 1310 264 C 1410 236 1510 248 1600 238 V420 Z" />
  <path fill="#90a7bb" d="M860 420 C 960 372 1060 360 1150 368 C 1270 336 1390 304 1600 332 V420 Z" />

  <!-- the shrine hill -->
