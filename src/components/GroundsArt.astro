  <rect y="818" width="1600" height="40" fill="#454a51" />
  <path d="M0 838 H1600" stroke="#f4f1ea" stroke-width="2.5" stroke-dasharray="26 22" opacity="0.8" />
  <rect y="858" width="1600" height="42" fill="#2f4a39" />

  <!-- palms and bushes -->
  <g>
    <use href="#ga-palm" x="150" y="756" width="60" height="66" />
    <use href="#ga-palm" x="470" y="694" width="54" height="60" />
    <use href="#ga-palm" x="560" y="612" width="60" height="66" />
    <use href="#ga-palm" x="796" y="520" width="56" height="62" />
    <use href="#ga-palm" x="858" y="388" width="62" height="68" />
    <use href="#ga-palm" x="1226" y="300" width="64" height="70" />
    <use href="#ga-palm" x="1290" y="356" width="58" height="64" />
