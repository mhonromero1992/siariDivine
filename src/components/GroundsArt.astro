      <rect x="1346" y="502" width="8" height="22" rx="4" fill="#3f6b4f" /><circle cx="1350" cy="499" r="4" fill="#d9b48f" />
      <rect x="1364" y="500" width="8" height="24" rx="4" fill="#7a5a3a" /><circle cx="1368" cy="497" r="4" fill="#d9b48f" />
      <rect x="1382" y="502" width="8" height="22" rx="4" fill="#1d4a6e" /><circle cx="1386" cy="499" r="4" fill="#d9b48f" />
      <rect x="1400" y="500" width="8" height="24" rx="4" fill="#b8860b" /><circle cx="1404" cy="497" r="4" fill="#d9b48f" />
      <rect x="1418" y="502" width="8" height="22" rx="4" fill="#f7f5ef" stroke="#c9c1b0" /><circle cx="1422" cy="499" r="4" fill="#d9b48f" />
    </g>
    <path d="M1438 668 C 1440 644 1468 630 1496 636 C 1522 640 1540 656 1536 676 Z" fill="#9a9a94" />
    <path d="M1474 640 C 1474 630 1480 622 1488 622 C 1494 622 1498 628 1498 634 L 1500 642 L 1470 642 Z" fill="#f2ead9" />
    <circle cx="1486" cy="614" r="6" fill="#d9b48f" />
