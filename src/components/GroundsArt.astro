    <path class="grounds-art__route" data-route d="M366 760 L 420 724 L 484 702 L 540 646 L 600 604 L 648 544 L 686 486 L 712 474 L 776 444 L 820 404 L 868 364 L 918 332 L 950 318 L 1080 312 L 1206 318 L 1250 364 L 1310 410 L 1342 470 L 1384 520 L 1432 572 L 1474 640" stroke="#a61e36" stroke-width="3" stroke-dasharray="1 0" opacity="0.9" />
  </g>

  <!-- Our Lady: white, on a blue cloud, with a ring of a halo, facing the sea -->
  <g data-st="our-lady">
    <circle cx="700" cy="438" r="40" fill="url(#ga-halo)" opacity="0.7" />
    <ellipse cx="700" cy="474" rx="22" ry="9" fill="#5d86c4" />
    <path d="M688 472 C 690 446 692 428 698 418 C 704 428 708 446 712 472 Z" fill="#fbfbff" />
    <path d="M693 434 C 696 430 704 430 707 434" stroke="#9dbbe6" stroke-width="2" fill="none" />
    <circle cx="700" cy="412" r="6.5" fill="#fbfbff" />
    <ellipse cx="700" cy="400" rx="9" ry="2.6" fill="none" stroke="#c9a85c" stroke-width="1.6" />
  </g>

  <!-- the summit: tower, chapel, roof deck, the Divine Mercy -->
  <g data-st="tower">
    <rect x="924" y="248" width="34" height="64" fill="#f7f5ef" />
    <rect x="928" y="204" width="26" height="44" fill="#fbfaf6" />
    <path d="M934 204 V248 M948 204 V248" stroke="#dcd7cc" stroke-width="1.2" />
    <rect x="930" y="178" width="22" height="26" fill="#f2efe8" />
    <path d="M926 179 L 941 136 L 956 179 Z" fill="#4a2a2f" />
    <path d="M941 136 V116 M934 123 H948" stroke="#f7f5ef" stroke-width="2.6" stroke-linecap="round" />
    <path d="M937 196 v-8 a4 4 0 0 1 8 0 v8 Z M937 236 v-10 a4 4 0 0 1 8 0 v10 Z" fill="#6d5a4c" />
  </g>

  <g data-st="petitions">
    <g>
      <rect x="892" y="286" width="26" height="26" fill="#f2efe8" />
      <path d="M896 312 v-14 a9 9 0 0 1 18 0 v14 Z" fill="#c9b79c" />
      <rect x="900" y="298" width="10" height="12" fill="#1d4a6e" />
