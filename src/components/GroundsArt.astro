    <path d="M958 250 Q 1074 214 1190 250 L 1190 262 Q 1074 230 958 262 Z" fill="#ffffff" />
    <path d="M958 262 Q 1074 230 1190 262" stroke="#dcd7cc" stroke-width="1.5" fill="none" />
    <rect x="1004" y="236" width="140" height="9" rx="2" fill="#a61e36" />
    <g fill="#f4f1ea" opacity="0.85">
