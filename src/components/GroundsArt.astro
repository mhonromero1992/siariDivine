    <rect x="338" y="706" width="56" height="13" rx="2" fill="#1d4a6e" />
    <rect x="346" y="711" width="40" height="3" rx="1.5" fill="#f4f1ea" opacity="0.8" />
  </g>

  <!-- the Walk of Faith: stairs with pink and blue rails, from the arch to Our Lady and on to the chapel -->
  <g fill="none" stroke-linecap="round" stroke-linejoin="round">
